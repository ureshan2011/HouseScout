# ---- HouseScout configuration ----
# Copy to .env and fill in. All values have sensible defaults for local use.

# Database (SQLite by default; swap for a Postgres URL to go multi-user later)
DATABASE_URL=sqlite:///./data/housescout.db

# LINZ Data Service (free) — get a key at https://data.linz.govt.nz/
LINZ_API_KEY=

# Analysis engine: none needed. HouseScout computes all valuation, rent, negotiation
# and growth figures in-process (backend/app/analysis.py, scripts/hedonic.py) with no
# model server, no API key and no network calls.

# Buyer profile / defaults. These seed the backend; in the static web app the same
# values are editable per-browser on the Settings page (frontend/lib/criteria.ts).
MAX_PRICE=500000
PREAPPROVAL=480000
DEPOSIT=50000
DEFAULT_MORTGAGE_RATE=0.0519
DEFAULT_TERM_YEARS=30
# Weekly rent you expect to charge per boarder room
BOARDER_WEEKLY_RENT=220

# ---- Scraper coverage ----
# Which districts to search. Accepts, comma separated:
#   a district key      christchurch-city,selwyn,dunedin-city
#   a whole region      canterbury
#   a whole island      island:south
#   everything          all
# The catalogue of 40 districts lives in scraper/regions.py. Every extra district is
# another full pass over the source site, so widen this deliberately.
SCRAPE_REGIONS=christchurch-city

# Pages per district per source.
SCRAPE_MAX_PAGES=12
# Ingestion price ceiling. NOT the buyer's budget: the valuation model calibrates on
# observed prices, and almost nothing under $500k publishes one, so ingestion reaches
# above the budget on purpose. The budget is applied by the scoring hard filters.
SCRAPE_PRICE_CEILING=1000000
# How many (source, district) scrapes run at once.
SCRAPE_CONCURRENCY=4
SCRAPE_INTERVAL_HOURS=6
SCRAPE_USER_AGENT=HouseScout/0.1 (personal use)
